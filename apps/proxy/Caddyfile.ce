{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

  redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

  redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000

	reverse_proxy /live/* live:3000

	# Athena BFF (chat, agents, Polo, knowledge graph). Served same-origin so the browser needs no
	# CORS and the session cookie is sent normally. strip_prefix because the BFF serves /api/v1, not
	# /athena-api/api/v1.
	#
	# By container name, not host.docker.internal:13101: the BFF is a container on this same network
	# now (infra/hosting/compose.yml) and publishes no host port. Pointing at the host gateway was
	# how this route 502'd the moment the BFF stopped being a loose process on the host.
	@athena path /athena-api/*
	uri @athena strip_prefix /athena-api
	reverse_proxy @athena athena-bff:13101

	reverse_proxy /api/* api:8000

	reverse_proxy /auth/* api:8000

	reverse_proxy /static/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000
	reverse_proxy /{$BUCKET_NAME} plane-minio:9000

	reverse_proxy /* web:3000
}

{$SITE_ADDRESS} {
	import plane_proxy
}